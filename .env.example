# IMAP inbox (Zoho EU). Same mailbox automailer uses.
# This project reads the Processed folder; it does not move mail.
IMAP_HOST=imap.zoho.eu
IMAP_PORT=993
IMAP_USER=nckonferencetilmelding@dig-in.dk
IMAP_PASS=
# IMAP_SECURE=true
# IMAP_FOLDER=Processed

# Hosted MySQL. `pnpm ingest` writes here.
DATABASE_URL=mysql://user:pass@host:3306/conference_tools

# Local devenv MariaDB is TEST_DATABASE_URL (set by devenv). Do not point
# DATABASE_URL at it. Tests and `pnpm ingest --local` use the local DB.
# TEST_DATABASE_URL=mysql://conference_tools_test:conference_tools_test@127.0.0.1:3306/conference_tools_test
