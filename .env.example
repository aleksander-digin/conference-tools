# IMAP inbox (Zoho EU). Same mailbox automailer uses.
# This project reads the Processed folder; it does not move mail.
IMAP_HOST=imap.zoho.eu
IMAP_PORT=993
IMAP_USER=nckonferencetilmelding@dig-in.dk
IMAP_PASS=
# IMAP_SECURE=true
# IMAP_FOLDER=Processed

# Hosted MySQL. Flake/local `pnpm ingest` writes to `submissions_test`.
# NixOS and GitHub Actions run `pnpm ingest --prod` and write to `submissions`.
# Both modes require TLS with a certificate trusted by the runner's system CAs.
DATABASE_URL=mysql://user:pass@host:3306/conference_tools
